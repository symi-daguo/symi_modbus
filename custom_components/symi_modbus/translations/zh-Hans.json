{
  "title": "Symi Modbus",
  "config": {
    "step": {
      "user": {
        "title": "选择连接类型",
        "data": {
          "type": "连接类型"
        }
      },
      "tcp": {
        "title": "配置 TCP 连接",
        "data": {
          "host": "主机",
          "port": "端口",
          "frame": "帧格式"
        }
      },
      "serial_pick": {
        "title": "选择串口设备",
        "description": "列表由运行 Home Assistant 的环境枚举（含常见 USB 串口）。请直接选择；若未列出，请选择最后一项手动输入路径。",
        "data": {
          "port": "串口设备"
        }
      },
      "serial_manual": {
        "title": "手动输入串口路径",
        "description": "填写在 Home Assistant 进程内可见的完整路径（Docker 需先映射设备）。例如 /dev/ttyUSB0、/dev/ttyAMA0 或 COM3。",
        "data": {
          "port": "设备路径"
        }
      },
      "serial_params": {
        "title": "串口参数",
        "data": {
          "baudrate": "波特率",
          "bytesize": "数据位",
          "parity": "校验位",
          "stopbits": "停止位"
        }
      },
      "slave": {
        "title": "Modbus 从站地址",
        "description": "填写本连接上的从站单元号（默认 10 即 0x0A）。如需在同一连接上添加更多从站，勾选后再填写下一个。",
        "data": {
          "slave": "从站地址（十进制）",
          "coil_count": "线圈数量",
          "add_more_slaves": "再添加一个从站"
        }
      }
    },
    "error": {
      "invalid_host": "请输入有效的主机名或 IP 地址",
      "invalid_serial_path": "请输入有效的串口设备路径",
      "slave_already_added": "此从站地址在本连接上已被添加",
      "no_slaves": "请至少添加一个从站地址"
    },
    "abort": {
      "already_configured": "此连接已配置"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Symi Modbus 选项",
        "data": {
          "scan_interval": "轮询间隔（秒）"
        }
      }
    }
  },
  "entity": {
    "switch": {
      "coil": {
        "name": "线路 {line}"
      }
    }
  },
  "services": {
    "write_coil": {
      "name": "写线圈",
      "description": "向 Modbus 设备写入线圈值。",
      "fields": {
        "address": {
          "name": "地址",
          "description": "线圈地址。"
        },
        "slave": {
          "name": "从站",
          "description": "从站单元号。"
        },
        "state": {
          "name": "状态",
          "description": "要写入的值。"
        },
        "hub": {
          "name": "主站",
          "description": "设置页面显示的配置项标题。只配置了一个连接时可留空。"
        }
      }
    },
    "write_register": {
      "name": "写寄存器",
      "description": "写入寄存器值。本设备类型暂不支持。",
      "fields": {
        "address": {
          "name": "地址",
          "description": "寄存器地址。"
        },
        "value": {
          "name": "值",
          "description": "要写入的值。"
        },
        "slave": {
          "name": "从站",
          "description": "从站单元号。"
        },
        "hub": {
          "name": "主站",
          "description": "设置页面显示的配置项标题。"
        }
      }
    }
  }
