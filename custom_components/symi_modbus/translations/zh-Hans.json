{
  "title": "Symi Modbus",
  "config": {
    "step": {
      "user": {
        "title": "选择连接类型",
        "data": {
          "type": "连接类型"
        },
        "description": "选择主站的接入方式。串口固定使用 RTU 帧，TCP 网关可选 Modbus TCP 或 RTU over TCP。"
      },
      "tcp": {
        "title": "配置 TCP 连接",
        "data": {
          "host": "主机",
          "port": "端口",
          "frame": "帧格式"
        },
        "description": "Modbus 网关的主机与端口。帧格式必须与网关一致，默认是 Modbus TCP，串口转网关系列设备请选 RTU over TCP。"
      },
      "serial_pick": {
        "title": "选择串口设备",
        "description": "列表由运行 Home Assistant 的环境枚举。请直接选择，或选择最后一项手动输入路径。",
        "data": {
          "port": "串口设备"
        }
      },
      "serial_manual": {
        "title": "串口设备路径",
        "description": "填写在 Home Assistant 进程内可见的完整路径，例如 /dev/ttyUSB0、/dev/ttyS0 或 COM3。Docker 需先把宿主设备映射进容器。",
        "data": {
          "port": "设备路径"
        }
      },
      "serial_params": {
        "title": "串口参数",
        "data": {
          "baudrate": "波特率",
          "bytesize": "数据位",
          "parity": "校验位",
          "stopbits": "停止位"
        },
        "description": "参数必须与设备一致。默认 9600 波特、8 数据位、无校验、1 停止位。"
      },
      "slave": {
        "title": "Modbus 从站地址",
        "description": "本连接上设备的单元号，10 即 0x0A。线圈数量是该设备实际拥有的线圈数，32 路模块填 32。之后可以在本集成页面继续添加从站。",
        "data": {
          "slave": "从站地址（十进制）",
          "start": "起始线圈",
          "coil_count": "线圈数量"
        }
      }
    },
    "error": {
      "invalid_host": "请输入有效的主机名或 IP 地址",
      "invalid_serial_path": "请输入有效的串口设备路径",
      "no_slaves": "请至少添加一个从站地址",
      "cannot_connect": "连接失败，请检查串口参数或从站地址"
    },
    "abort": {
      "already_configured": "此连接已配置"
    }
  },
  "config_subentries": {
    "slave": {
      "entry_type": "Modbus 从站",
      "initiate_flow": {
        "user": "添加从站",
        "reconfigure": "修改从站"
      },
      "step": {
        "user": {
          "title": "添加 Modbus 从站",
          "description": "本连接上设备的单元号，10 即 0x0A。线圈数量是该设备实际拥有的线圈数，32 路模块填 32。",
          "data": {
            "slave": "从站地址（十进制）",
            "start": "起始线圈",
            "coil_count": "线圈数量"
          }
        },
        "reconfigure": {
          "title": "修改 Modbus 从站",
          "data": {
            "slave": "从站地址（十进制）",
            "start": "起始线圈",
            "coil_count": "线圈数量"
          }
        }
      },
      "error": {
        "slave_already_added": "此从站地址在本连接上已被添加"
      }
    },
    "panel": {
      "entry_type": "面板总线",
      "initiate_flow": {
        "user": "添加面板总线",
        "reconfigure": "修改面板总线"
      },
      "step": {
        "user": {
          "title": "添加面板总线",
          "description": "面板所在的串口以及面板品牌。品牌决定用哪套协议读取按键和驱动指示灯。",
          "data": {
            "brand": "面板品牌",
            "port": "串口设备",
            "baudrate": "波特率",
            "bytesize": "数据位",
            "parity": "校验位",
            "stopbits": "停止位",
            "panel_start": "起始面板地址",
            "panel_count": "面板数量",
            "buttons": "每面板按键数"
          }
        },
        "reconfigure": {
          "title": "修改面板总线",
          "data": {
            "brand": "面板品牌",
            "port": "串口设备",
            "baudrate": "波特率",
            "bytesize": "数据位",
            "parity": "校验位",
            "stopbits": "停止位",
            "panel_start": "起始面板地址",
            "panel_count": "面板数量",
            "buttons": "每面板按键数"
          }
        }
      },
      "error": {
        "invalid_panel_path": "请输入有效的串口设备路径"
      }
    },
    "linkage": {
      "entry_type": "按键关联",
      "initiate_flow": {
        "user": "添加按键关联",
        "reconfigure": "修改按键关联"
      },
      "step": {
        "user": {
          "title": "把面板按键与继电器关联",
          "description": "选择面板上的按键和 Modbus 从站的继电器。状态双向同步：按键控制继电器，继电器状态回写到按键指示灯。",
          "data": {
            "panel_entities": "面板按键",
            "relay_entities": "Modbus 继电器"
          }
        },
        "reconfigure": {
          "title": "修改按键关联",
          "data": {
            "panel_entities": "面板按键",
            "relay_entities": "Modbus 继电器"
          }
        }
      },
      "error": {
        "linkage_empty": "请至少选择一个面板按键和一个继电器",
        "not_a_panel_button": "所选实体不是本集成的面板按键",
        "not_a_coil": "所选实体不是本集成的继电器"
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Symi Modbus 选项",
        "data": {
          "scan_interval": "轮询间隔（秒）"
        },
        "description": "一轮轮询所有从站所用的时间。每台从站每轮被问一次，所以两台从站之间的间隔等于轮询间隔除以从站数量。"
      }
    }
  },
  "entity": {
    "switch": {
      "coil": {
        "name": "{slave} 线路 {line}"
      },
      "panel_button": {
        "name": "按键 {button}"
      }
    }
  },
  "services": {
    "write_coil": {
      "name": "写线圈",
      "description": "向 Modbus 设备写入线圈值。",
      "fields": {
        "address": {
          "name": "地址",
          "description": "线圈地址。"
        },
        "slave": {
          "name": "从站",
          "description": "从站单元号。"
        },
        "state": {
          "name": "状态",
          "description": "要写入的值。"
        },
        "hub": {
          "name": "主站",
          "description": "设置页面显示的配置项标题。只配置了一个连接时可留空。"
        }
      }
    },
    "write_register": {
      "name": "写寄存器",
      "description": "写入寄存器值。本设备类型暂不支持。",
      "fields": {
        "address": {
          "name": "地址",
          "description": "寄存器地址。"
        },
        "value": {
          "name": "值",
          "description": "要写入的值。"
        },
        "slave": {
          "name": "从站",
          "description": "从站单元号。"
        },
        "hub": {
          "name": "主站",
          "description": "设置页面显示的配置项标题。"
        }
      }
    }
  }
}
